{
  "name": "schooldesk",
  "version": "0.0.1",
  "private": true,
  "description": "An offline class, assignment, notes, and calendar workspace.",
  "author": "Schooldesk",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.mjs",
    "desktop:smoke": "npm run build && electron scripts/test-desktop.cjs",
    "desktop": "electron electron/main.cjs",
    "desktop:test": "npm run build && npm run desktop",
    "desktop:package": "npm run desktop:prepare && electron-builder",
    "desktop:prepare": "npm run build && node -e \"require('node:fs').mkdirSync('release',{recursive:true})\"",
    "desktop:release": "npm run desktop:package -- --publish always",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.5.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.2.6",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.5.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.schooldesk.app",
    "productName": "Schooldesk",
    "artifactName": "Schooldesk-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/client/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
